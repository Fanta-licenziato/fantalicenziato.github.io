rules_version = '2';
// Regole di sicurezza del Fanta Licenziato.
// Se cambi adminNick in config.js, cambia "erre" qui sotto (tutto minuscolo, senza spazi).
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && request.auth.token.email == 'erre@fanta-licenziato.app'; }

    // soprannomi dei giocatori
    match /users/{uid} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == uid
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 24;
    }

    // rosa: chiunque aggiunge, solo l'admin modifica o toglie
    match /players/{id} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow update, delete: if isAdmin();
    }

    // puntate: ognuno scrive solo le proprie
    match /bets/{uid} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == uid;
    }

    // esiti (licenziati): solo l'admin
    match /esiti/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    // bacheca anonima: tutti leggono, nessuno vede l'autore
    match /bacheca/{id} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
        && request.resource.data.risate == 0
        && getAfter(/databases/$(database)/documents/bacheca_autori/$(id)).data.uid == request.auth.uid;
      allow update: if signed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['risate'])
        && request.resource.data.risate == resource.data.risate + 1;
      allow delete: if isAdmin()
        || get(/databases/$(database)/documents/bacheca_autori/$(id)).data.uid == request.auth.uid;
    }

    // chi ha scritto cosa: lo vede solo l'autore stesso e l'admin
    match /bacheca_autori/{id} {
      allow read: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
      allow create: if signed() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
    }
  }
}
