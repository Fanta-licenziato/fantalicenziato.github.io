rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && request.auth.token.email == 'erre@fanta-licenziato.app'; }
    function active() { return signed() && !exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }

    match /users/{uid} {
      allow read: if signed();
      allow write: if active() && request.auth.uid == uid
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 24;
      allow delete: if isAdmin();
    }

    match /players/{id} {
      allow read: if signed();
      allow create: if active()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow update, delete: if isAdmin();
    }

    match /bets/{uid} {
      allow read: if signed();
      allow write: if active() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /esiti/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    // portafogli a quote: ognuno scrive solo il suo
    match /pos/{uid} {
      allow read: if signed();
      allow write: if active() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // eventi Sì/No: chiunque li crea, chi li ha creati li decide dopo la chiusura, l'admin sempre
    match /events/{id} {
      allow read: if signed();
      allow create: if active()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.q is string
        && request.resource.data.q.size() >= 5 && request.resource.data.q.size() <= 120
        && request.resource.data.status == 'open'
        && (request.resource.data.feat == false || isAdmin());
      allow update: if isAdmin() || (active()
        && resource.data.by == request.auth.uid
        && request.time.toMillis() >= resource.data.closeAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedBy','resolvedAt'])
        && request.resource.data.status in ['yes','no','void']);
      allow delete: if isAdmin();
    }

    match /banned/{uid} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    match /bacheca/{id} {
      allow read: if signed();
      allow create: if active()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
        && request.resource.data.risate == 0
        && getAfter(/databases/$(database)/documents/bacheca_autori/$(id)).data.uid == request.auth.uid;
      allow update: if active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['risate'])
        && request.resource.data.risate == resource.data.risate + 1;
      allow delete: if isAdmin()
        || get(/databases/$(database)/documents/bacheca_autori/$(id)).data.uid == request.auth.uid;
    }

    match /bacheca_autori/{id} {
      allow read: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
      allow create: if active() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
    }
  }
}
